rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public trust dashboard aggregates — readable by anyone, written only by the admin SDK
    match /ledger_aggregates/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Audit log for model extractions and deterministic verdicts. Append-only.
    match /decision_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Early-access email capture. Write-only from the public page: anyone may add
    // themselves, nobody may read the list back or alter an existing entry.
    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','created','source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.email.size() < 255;
      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
